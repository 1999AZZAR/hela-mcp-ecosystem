{
  "mcp": {
    "hela-mitosis": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/chaining-mcp-server/dist/index.js"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/path/to/mcp-ecosystem/chaining-mcp-server/data/memory.json",
        "SEQUENTIAL_THINKING_AVAILABLE": "true",
        "AWESOME_COPILOT_ENABLED": "true",
        "RELIABILITY_MONITORING_ENABLED": "true",
        "CHAINING_TOOL_TIMEOUT_MS": "10000",
        "CHAINING_LLM_ENABLED": "false",
        "CHAINING_LLM_MODEL": "openrouter/free",
        "CHAINING_LLM_BASE_URL": "https://openrouter.ai/api/v1"
      }
    },
    "hela-genome": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/Project-Guardian-mcp-server/dist/index.js"
      ]
    },
    "hela-membrane": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/filesystem-mcp-server/dist/index.js"
      ]
    },
    "hela-nucleus": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/terminal-mcp-server/build/index.js"
      ]
    },
    "hela-ribosome": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/menager-mcp-server/build/index.js"
      ]
    },
    "hela-enzyme": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/research-mcp-server/dist/index.js"
      ],
      "environment": {
        "WIKIPEDIA_CACHE_MAX": "100",
        "WIKIPEDIA_CACHE_TTL": "300000",
        "WIKIPEDIA_DEFAULT_LANGUAGE": "en"
      }
    },
    "hela-phenotype": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/the-designer/dist/index.js"
      ]
    },
    "hela-cytosol": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/path/to/mcp-ecosystem/browser-agent/src/server.js"
      ]
    }
  }
}
